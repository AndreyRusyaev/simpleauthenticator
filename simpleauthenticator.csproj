<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>simpleauthenticator</RootNamespace>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <GenerateProgramFile>false</GenerateProgramFile>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>simpleauthenticator</ToolCommandName>

    <Version>1.0.0</Version>
    <Description>Cross-platform C#/.Net tool to generate one time passwords for open authentication defined by standard RFC's.</Description>
    <Copyright>Andrey Rusyaev</Copyright>
    <Authors>Andrey Rusyaev</Authors>
    <RepositoryUrl>https://github.com/AndreyRusyaev/simpleauthenticator</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>otp totp hotp google-authenticator rfc6238 otp-generator rfc4226 one-time-password totp-generator microsoft-authenticator hotp-generator</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/AndreyRusyaev/simpleauthenticator</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
